<mujoco model="rabbit">
    <compiler angle="radian" autolimits="true"/>

    <default>
        <default class="rabbit">
            <geom type="capsule"/>
        </default>
        <default class="virtual_joint">
            <joint damping="0" armature="0" frictionloss="0"/>
        </default>
    </default>

    <keyframe>
        <key name="0" qpos="0 1 0 0 0 0 0" />
    </keyframe>

    <worldbody>
        <body name="base" pos="0 0 0">
            <joint name="x_joint" type="slide" axis="1 0 0" range="-100 100" class="virtual_joint"/>
            <joint name="z_joint" type="slide" axis="0 0 1" range="-100 100" class="virtual_joint"/>
            <joint name="pitch_joint" type="hinge" axis="0 1 0" class="virtual_joint"/>
            
            <body name="torso">
                <inertial pos="0 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
                <geom name="torso_geom" type="box" size="0.04 0.04 0.1" rgba="1 1 0 1"/>

                <!-- right leg -->
                <body name="right_hip" pos="0 -0.02 -0.1">
                    <joint name="right_hip_ry" type="hinge" axis="0 1 0"/>
                    <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0 0 1 1"/>
                    <body name="right_knee" pos="0 0 -0.2">
                        <joint name="right_knee_ry" type="hinge" axis="0 1 0"/>
                        <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0 1 0 1"/>
                    </body>
                </body>

                <!-- left leg -->
                <body name="left_hip" pos="0 0.02 -0.1">
                    <joint name="left_hip_ry" type="hinge" axis="0 1 0"/>
                    <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0 0 1 1"/>
                    <body name="left_knee" pos="0 0 -0.2">
                        <joint name="left_knee_ry" type="hinge" axis="0 1 0"/>
                        <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.02" rgba="0 1 0 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name = "right_hip_motor" joint="right_hip_ry"/>
        <motor name = "right_knee_motor" joint="right_knee_ry"/>
        <motor name = "left_hip_motor" joint="left_hip_ry"/>
        <motor name = "left_knee_motor" joint="left_knee_ry"/>
    </actuator>

    <sensor>
        <jointpos name="right_hip_pos" joint="right_hip_ry"/>
        <jointpos name="right_knee_pos" joint="right_knee_ry"/>
        <jointpos name="left_hip_pos" joint="left_hip_ry"/>
        <jointpos name="left_knee_pos" joint="left_knee_ry"/>

        <jointvel name="right_hip_vel" joint="right_hip_ry"/>
        <jointvel name="right_knee_vel" joint="right_knee_ry"/>
        <jointvel name="left_hip_vel" joint="left_hip_ry"/>
        <jointvel name="left_knee_vel" joint="left_knee_ry"/>

        <jointactuatorfrc name="right_hip_tau" joint="right_hip_ry"/>
        <jointactuatorfrc name="right_knee_tau" joint="right_knee_ry"/>
        <jointactuatorfrc name="left_hip_tau" joint="left_hip_ry"/>
        <jointactuatorfrc name="left_knee_tau" joint="left_knee_ry"/>
    </sensor>
</mujoco>