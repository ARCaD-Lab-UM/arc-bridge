package lcm_msgs;

struct tron1_wheeled_control_t
{
    int64_t  timestamp;

    double   qj_tau[8];

    double   qj_pos[8];
    double   qj_vel[8];

    double   kp[8];
    double   kd[8];

    boolean  reset_se;

    double  contact[2]; // scheduled contact for each foot

    double u_wrench[8];

    int64_t cost;

    double   pw_body_cur[6];
    double   pw_body_next[6];
}
