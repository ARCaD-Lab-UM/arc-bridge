package lcm_msgs;

struct rabbit_state_t
{
    int64_t timestamp;

    double position[3];
    double quaternion[4];
    double rpy[3];
    double velocity[3];
    double omega[3];
    double acceleration[3];

    double qj_pos[4];
    double qj_vel[4];
    double qj_tau[4];

    double inertia_mat[7][7];
    double bias_force[7];
}
