package lcm_msgs;

struct rabbit_state_t
{
    int64_t timestamp;

    double pc[3];
    double quat[4];
    double rpy[3];
    double vel[3];
    double omega[3];
    double acc[3];

    double qj_pos[4];
    double qj_vel[4];
    double qj_tau[4];

    double inertia_mat[7][7];
    double bias_force[7];
}
