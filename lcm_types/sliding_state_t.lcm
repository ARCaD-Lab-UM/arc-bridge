package lcm_msgs;

struct sliding_state_t
{
    int64_t  timestamp;

    double   position[3];
    double   quaternion[4];
    double   rpy[3];

    double   acceleration[3];

    double   velocity[3];
    double   omega[3];

    double   qj_pos[8];
    double   qj_vel[8];
    double   qj_tau[8];

    double  pos_ob[3];
    double  quat_ob[4];
    double  vel_ob[3];
    double  omega_ob[3];
}
