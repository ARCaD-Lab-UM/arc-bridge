package lcm_msgs;

struct gamepad_cmd_t
{
    int64_t  timestamp;

    boolean  e_stop;

    double   axis[4]; // +[0]=L West, +[1]=L North, +[2]=R West, +[3]=R North

    int8_t   params[2]; // D-Pad values

    boolean  btn_up; // Face button
    boolean  btn_left;
    boolean  btn_down;
    boolean  btn_right;

    boolean  btn_lb; // Bumper
    boolean  btn_rb;

    boolean  btn_lstick; // Stick press
    boolean  btn_rstick;

    double lt; // Trigger
    double rt;
}
